<footer class="py-12 px-6 bg-primary/95 text-white">
  <div class="max-w-5xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-6">
    <p class="text-white/80 text-sm">
      Togavganger – Wear OS-app for norske togavganger. Data fra Entur.
    </p>
    <div class="flex flex-wrap gap-6 text-sm justify-center sm:justify-end">
      <a href="/personvern" class="text-white/80 hover:text-white transition-colors">
        Personvern
      </a>
      <a href="mailto:togavganger@gmail.com" class="text-white/80 hover:text-white transition-colors">
        Kontakt utvikler
      </a>
      <a href="https://entur.no" target="_blank" rel="noopener noreferrer" class="text-white/80 hover:text-white transition-colors">
        Entur
      </a>
      <a href="https://developer.entur.org" target="_blank" rel="noopener noreferrer" class="text-white/80 hover:text-white transition-colors">
        Entur API
      </a>
      <button
        id="source-btn"
        class="text-white/80 hover:text-white transition-colors cursor-pointer"
      >
        Kildekode
      </button>
    </div>
  </div>
</footer>

<div
  id="source-modal"
  class="fixed inset-0 z-50 hidden items-center justify-center p-4"
  role="dialog"
  aria-modal="true"
  aria-labelledby="source-modal-title"
>
  <div id="source-backdrop" class="absolute inset-0 bg-black/50"></div>
  <div class="relative bg-white rounded-2xl shadow-2xl p-8 w-full max-w-sm flex flex-col gap-4">
    <h2 id="source-modal-title" class="text-primary font-semibold text-lg text-center">Velg kildekode</h2>
    <a
      href="https://github.com/philipostli/no.togavganger"
      target="_blank"
      rel="noopener noreferrer"
      class="flex items-center gap-3 rounded-xl border border-primary/20 px-5 py-4 hover:bg-primary/5 transition-colors text-primary"
    >
      <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 shrink-0" viewBox="0 0 24 24" fill="currentColor">
        <path d="M12 2C6.477 2 2 6.477 2 12c0 4.418 2.865 8.166 6.839 9.489.5.092.682-.217.682-.482 0-.237-.009-.868-.013-1.703-2.782.604-3.369-1.34-3.369-1.34-.454-1.156-1.11-1.463-1.11-1.463-.908-.62.069-.608.069-.608 1.003.07 1.531 1.03 1.531 1.03.892 1.529 2.341 1.087 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.11-4.555-4.943 0-1.091.39-1.984 1.029-2.683-.103-.253-.446-1.27.098-2.647 0 0 .84-.269 2.75 1.025A9.578 9.578 0 0 1 12 6.836a9.59 9.59 0 0 1 2.504.337c1.909-1.294 2.747-1.025 2.747-1.025.546 1.377.203 2.394.1 2.647.64.699 1.028 1.592 1.028 2.683 0 3.842-2.339 4.687-4.566 4.935.359.309.678.919.678 1.852 0 1.336-.012 2.415-.012 2.742 0 .267.18.578.688.48C19.138 20.163 22 16.418 22 12c0-5.523-4.477-10-10-10z"/>
      </svg>
      <div>
        <div class="font-medium text-sm">Wear OS-app</div>
        <div class="text-primary/50 text-xs">no.togavganger</div>
      </div>
    </a>
    <a
      href="https://github.com/philipostli/no.togavganger.web"
      target="_blank"
      rel="noopener noreferrer"
      class="flex items-center gap-3 rounded-xl border border-primary/20 px-5 py-4 hover:bg-primary/5 transition-colors text-primary"
    >
      <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 shrink-0" viewBox="0 0 24 24" fill="currentColor">
        <path d="M12 2C6.477 2 2 6.477 2 12c0 4.418 2.865 8.166 6.839 9.489.5.092.682-.217.682-.482 0-.237-.009-.868-.013-1.703-2.782.604-3.369-1.34-3.369-1.34-.454-1.156-1.11-1.463-1.11-1.463-.908-.62.069-.608.069-.608 1.003.07 1.531 1.03 1.531 1.03.892 1.529 2.341 1.087 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.11-4.555-4.943 0-1.091.39-1.984 1.029-2.683-.103-.253-.446-1.27.098-2.647 0 0 .84-.269 2.75 1.025A9.578 9.578 0 0 1 12 6.836a9.59 9.59 0 0 1 2.504.337c1.909-1.294 2.747-1.025 2.747-1.025.546 1.377.203 2.394.1 2.647.64.699 1.028 1.592 1.028 2.683 0 3.842-2.339 4.687-4.566 4.935.359.309.678.919.678 1.852 0 1.336-.012 2.415-.012 2.742 0 .267.18.578.688.48C19.138 20.163 22 16.418 22 12c0-5.523-4.477-10-10-10z"/>
      </svg>
      <div>
        <div class="font-medium text-sm">Nettside</div>
        <div class="text-primary/50 text-xs">no.togavganger.web</div>
      </div>
    </a>
    <button
      id="source-close"
      class="mt-2 text-sm text-primary/50 hover:text-primary transition-colors"
    >
      Lukk
    </button>
  </div>
</div>

<script>
  const btn = document.getElementById('source-btn');
  const modal = document.getElementById('source-modal');
  const backdrop = document.getElementById('source-backdrop');
  const closeBtn = document.getElementById('source-close');

  function openModal() {
    modal?.classList.remove('hidden');
    modal?.classList.add('flex');
  }

  function closeModal() {
    modal?.classList.add('hidden');
    modal?.classList.remove('flex');
  }

  btn?.addEventListener('click', openModal);
  backdrop?.addEventListener('click', closeModal);
  closeBtn?.addEventListener('click', closeModal);

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeModal();
  });
</script>
